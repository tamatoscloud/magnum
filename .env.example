# Copy to .env for local development. Replace every value before production.
# Production startup rejects mock delivery, local storage, and these sample secrets.

NODE_ENV=development
DATABASE_URL=postgresql://magnum:magnum@127.0.0.1:5433/magnum
REDIS_URL=redis://localhost:6379
NEXTAUTH_SECRET=dev-only-nextauth-secret-change-me-now
NEXTAUTH_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
TOKEN_ENCRYPTION_KEY=ZGV2LW9ubHktdG9rZW4ta2V5LW5vdC1mb3ItcHJvZCE=

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./.data/storage
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=magnum-documents
STORAGE_ACCESS_KEY=replace-me
STORAGE_SECRET_KEY=replace-me
STORAGE_FORCE_PATH_STYLE=true

EMAIL_PROVIDER=mock
EMAIL_FROM="Magnum <statements@example.com>"
EMAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_WEBHOOK_SECRET=

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_NAME=dividend_statement
WHATSAPP_TEMPLATE_LANG=en

MAX_UPLOAD_SIZE_MB=2048
DEFAULT_LINK_EXPIRY_DAYS=30
VERIFICATION_SESSION_TTL_MINUTES=15
MAX_VERIFICATION_ATTEMPTS=5
MOCK_EMAIL_ENABLED=true
MOCK_WHATSAPP_ENABLED=true

PDF_PASSWORD_POLICY=folio
PDF_ENCRYPTION_BITS=256
QPDF_BIN=qpdf
DEFAULT_PHONE_REGION=PK
FOLIO_GLOBALLY_UNIQUE=false
WORKER_CONCURRENCY=4
ORIGINAL_RETENTION_DAYS=30
ENCRYPTED_RETENTION_DAYS=365
EXPORT_RETENTION_HOURS=24
MAX_CAMPAIGN_PDF_MB=100
CAMPAIGN_PDF_CONCURRENCY=2
PDF_GENERATION_TIMEOUT_MS=120000
CAMPAIGN_TEMP_MAX_AGE_MINUTES=30
